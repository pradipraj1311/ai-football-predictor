{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/index.ts"
    },
    {
      "src": "/robots.txt",
      "dest": "/index.ts"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/index.ts"
    },
    {
      "src": "/world-cup-2026",
      "dest": "/index.ts"
    },
    {
      "src": "/ai-football-predictions",
      "dest": "/index.ts"
    },
    {
      "src": "/live-football-scores",
      "dest": "/index.ts"
    },
    {
      "src": "/fantasy-football-ai",
      "dest": "/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}